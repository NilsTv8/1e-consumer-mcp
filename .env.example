# ── 1E API connection (required) ──────────────────────────────────────────────
ONE_E_BASE_URL=https://your-tenant.1e.com/consumer

# ── Authentication — pick ONE mode ────────────────────────────────────────────

# Mode 1: Modern OAuth / JWT Certificate Assertion (recommended)
# The server auto-obtains and refreshes the Tachyon token using your Azure AD
# app registration and certificate. No manual token rotation needed.
#
# ONE_E_PRIVATE_KEY     RSA private key in PEM format (the signing key)
# ONE_E_CERTIFICATE     X.509 certificate in PEM format (for thumbprint)
# ONE_E_APPLICATION_ID  Azure AD application (client) ID
# ONE_E_CONSUMER_NAME   Tachyon consumer name registered in 1E
#
# Tip: multi-line PEM values can be stored as-is if your deployment
#      platform supports multi-line env vars (Docker, Kubernetes secrets, etc.)
ONE_E_PRIVATE_KEY=
ONE_E_CERTIFICATE=
ONE_E_APPLICATION_ID=
ONE_E_CONSUMER_NAME=

# Mode 2: Static bearer token (manual rotation required)
ONE_E_BEARER_TOKEN=

# Mode 3: API key
# ONE_E_API_KEY=

# ── Transport ─────────────────────────────────────────────────────────────────
# stdio  → Claude Desktop / local MCP clients (default)
# http   → Remote HTTP deployment
TRANSPORT=stdio

# ── HTTP mode only ────────────────────────────────────────────────────────────
PORT=3000
# Required in HTTP mode UNLESS ONE_E_CLIENT_SUPPLIED_KEY=true (a valid
# X-API-Key then satisfies the gate on its own — needed for MCP clients like
# Microsoft Copilot Studio that can only configure one credential). Generate:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=change-me-to-a-strong-random-secret

# Set to "true" to let multiple MCP clients (Claude, Copilot Studio, etc.)
# share one hosted server instance, each bringing its own 1E API key via an
# X-API-Key header (or api_key/apiKey query param) instead of the server
# using the single credential configured above. When enabled,
# ONE_E_PRIVATE_KEY/ONE_E_BEARER_TOKEN/ONE_E_API_KEY above are unused — only
# ONE_E_BASE_URL and ONE_E_CONSUMER_NAME still apply (as the default tenant).
# ONE_E_CLIENT_SUPPLIED_KEY=true

# Set to "true" (requires ONE_E_CLIENT_SUPPLIED_KEY=true) to let each session
# also pick its own 1E tenant via an X-1E-Base-URL header (or
# base_url/baseUrl query param), instead of always hitting ONE_E_BASE_URL.
# Every supplied URL is SSRF-validated (HTTPS-only, DNS-checked against
# private/loopback/link-local ranges) before use. Never combine with a
# shared server-side credential — see README for why.
# ONE_E_CLIENT_SUPPLIED_TENANT=true

# Optional (any transport). Comma-separated list of tool names to expose —
# everything else is hidden from tools/list and rejected if called anyway.
# Cuts the token cost of the tool catalog an LLM has to reason over. Unset =
# all 92 tools available.
#
# The list below is the recommended scope for device health identification
# and remediation: find devices → find the right health-check/remediation
# instruction → run it → track it to completion. Comment out to expose the
# full tool catalog instead.
ONE_E_TOOL_ALLOWLIST=devices_list,devices_search,devices_get_by_fqdn,devices_summary,management_groups_list,management_groups_get_contents,instruction_definitions_search,instruction_definitions_get_by_name,instructions_send,instructions_send_to_device,instructions_get_by_id,instructions_get_statistics,instructions_get_statistics_detail,instructions_get_responses,instructions_get_responses_aggregate,instructions_rerun,instructions_cancel

# ── Public HTTPS deployment (docker-compose + Caddy) ──────────────────────────
# Your public domain — must have a DNS A record pointing to this server
DOMAIN=mcp.yourcompany.com

# Allowed CORS origin. Set to your client's origin (e.g. https://app.yourcompany.com)
# or leave as * to allow all origins.
CORS_ORIGIN=*
